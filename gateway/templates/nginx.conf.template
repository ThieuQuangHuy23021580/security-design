# ==============================================================================
# Nginx API Gateway - cau hinh chinh
#
# Ba nhiem vu chinh cua API Gateway:
#   1. ROUTING    : /users -> User Service, /orders -> Order Service
#   2. OFFLOADING : xac thuc JWT + gioi han toc do (10 req/s) tai Gateway
#   3. AGGREGATION: /dashboard -> gateway-core (goi SONG SONG 2 service roi tong hop)
#
# File nay la TEMPLATE. Docker Compose chay `envsubst` (chi thay the cac bien
# duoc liet ke trong NGINX_ENVSUBST_FILTER) de sinh ra /etc/nginx/nginx.conf.
#
# CAC BIEN DUOC THAY THE:
#   ${GATEWAY_PORT} ${RATE_LIMIT_RATE} ${RATE_LIMIT_BURST} ${JWT_SECRET}
#   ${USER_SERVICE_HOST} ${USER_SERVICE_PORT}
#   ${ORDER_SERVICE_HOST} ${ORDER_SERVICE_PORT}
#   ${GATEWAY_CORE_HOST} ${GATEWAY_CORE_PORT}
#
# LUU Y: moi bien nginx ($remote_addr, $host, ...) KHONG duoc envsubst;
# chinh vi vay dung NGINX_ENVSUBST_FILTER de gioi han danh sach bien thay the.
# ==============================================================================

load_module /usr/lib/nginx/modules/ngx_http_auth_jwt_module.so;

worker_processes  auto;

events {
    worker_connections  1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" rt=$request_time';
    access_log  /var/log/nginx/access.log  main;
    error_log   /var/log/nginx/error.log  warn;

    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout  65;
    server_tokens   off;

    client_max_body_size 10m;

    # Docker DNS: cho phep nginx phan giai hostname container tai thoi diem
    # request (tranh truong hop container bi khoi dong lai va doi IP).
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;

    # --------------------------------------------------------------------------
    # RATE LIMITING - 10 request/giay cho moi dia chi IP client.
    #
    # Zone "perip" dung chung cho TOAN BO cac route cua Gateway, nen mot client
    # khong the "chay vong" giua /users, /orders, /dashboard de vuot han muc.
    #   rate = ${RATE_LIMIT_RATE}  -> 10 request/giay
    #   burst = ${RATE_LIMIT_BURST} -> cho phep giu them mot nhom request ngan
    #   nodelay                    -> khong treo request, thay bang 429 ngay
    #
    # LUU Y: limit_req_zone phai nam o context `http` (khong phai `server`).
    # --------------------------------------------------------------------------
    limit_req_zone $binary_remote_addr zone=perip:10m rate=${RATE_LIMIT_RATE};
    limit_req_status 429;
    limit_req_log_level warn;

    # Zone rieng cho cong benchmark (noi bo): rate rat cao de KHONG lam sai
    # lech do overhead cua Gateway (theo yeu cau E).
    limit_req_zone $binary_remote_addr zone=bench:10m rate=10000r/s;

    # --------------------------------------------------------------------------
    # JWT - module ngx_http_auth_jwt_module.
    #
    # "sub" la claim dinh danh nguoi dung. Module tra ve gia tri JSON-encode
    # (co dau nhay kép), nhung ta chi can biet co ton tai hay khong.
    # Yeu cau "sub" khac rong -> token khong co danh tinh se bi 401.
    # --------------------------------------------------------------------------
    map $jwt_claim_sub $jwt_has_sub {
        "~^\S+$"  1;
        default   0;
    }

    # ======================================================================
    # API GATEWAY CHINH - cong cong, moi request cua client deu di qua day.
    # ======================================================================
    server {
        listen      ${GATEWAY_PORT};
        server_name _;

        # --- OFFLOADING 1: gioi han toc do.
        #     limit_req ap dung rieng cho tung location (xem ben duoi) de
        #     /health va / khong bi anh huong.

        # --- OFFLOADING 2: khoa xac thuc JWT dung chung cho cac route
        #     duoc bao ve. Khi khai bao o server level, cac location con
        #     ke thua (chi can khai bao `auth_jwt on;` tai tung location).
        auth_jwt_key "${JWT_SECRET}";
        auth_jwt_alg HS256;

        # ==================================================================
        # A) ROUTING: /users -> User Service
        # ==================================================================
        location /users {
            limit_req zone=perip burst=${RATE_LIMIT_BURST} nodelay;

            auth_jwt on;
            auth_jwt_require $jwt_has_sub;

            # Dung bien de proxy_pass => nginx phan giai hostname tai runtime
            # qua Docker DNS thay vi luc khoi dong.
            set $upstream_users "http://${USER_SERVICE_HOST}:${USER_SERVICE_PORT}";
            proxy_pass $upstream_users;

            proxy_set_header Host              $host;
            proxy_set_header Authorization     $http_authorization;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            # Xoa header danh tinh do client gui len de tranh gia mao.
            proxy_set_header X-User-Id         "";
        }

        # ==================================================================
        # B) ROUTING: /orders -> Order Service
        # ==================================================================
        location /orders {
            limit_req zone=perip burst=${RATE_LIMIT_BURST} nodelay;

            auth_jwt on;
            auth_jwt_require $jwt_has_sub;

            set $upstream_orders "http://${ORDER_SERVICE_HOST}:${ORDER_SERVICE_PORT}";
            proxy_pass $upstream_orders;

            proxy_set_header Host              $host;
            proxy_set_header Authorization     $http_authorization;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-User-Id         "";
        }

        # ==================================================================
        # C) AGGREGATION: /dashboard -> gateway-core
        #    Gateway Core goi SONG SONG User Service + Order Service
        #    roi tong hop thanh mot JSON response.
        # ==================================================================
        location /dashboard {
            limit_req zone=perip burst=${RATE_LIMIT_BURST} nodelay;

            auth_jwt on;
            auth_jwt_require $jwt_has_sub;

            set $upstream_gateway_core "http://${GATEWAY_CORE_HOST}:${GATEWAY_CORE_PORT}";
            proxy_pass $upstream_gateway_core;

            proxy_set_header Host              $host;
            proxy_set_header Authorization     $http_authorization;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-User-Id         "";
        }

        # ==================================================================
        # D) AUTH: /auth/* -> gateway-core (cap / kiem tra JWT) - route public
        # ==================================================================
        location /auth {
            limit_req zone=perip burst=${RATE_LIMIT_BURST} nodelay;

            auth_jwt off;

            set $upstream_gateway_core "http://${GATEWAY_CORE_HOST}:${GATEWAY_CORE_PORT}";
            proxy_pass $upstream_gateway_core;

            proxy_set_header Host              $host;
            proxy_set_header Authorization     $http_authorization;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ==================================================================
        # E) HEALTH CHECK cua Gateway
        # ==================================================================
        location = /health {
            access_log off;
            auth_jwt off;

            set $upstream_gateway_core "http://${GATEWAY_CORE_HOST}:${GATEWAY_CORE_PORT}";
            proxy_pass $upstream_gateway_core/health;
            proxy_set_header Host $host;
        }

        # ==================================================================
        # F) TRANG CHU - huong dan nhanh
        # ==================================================================
        location = / {
            default_type application/json;
            return 200 '{"service":"api-gateway","status":"ok","endpoints":["/users","/orders","/dashboard","/auth/login","/auth/verify","/health"]}';
        }
    }

    # ======================================================================
    # API GATEWAY BEN TRONG - CHI dung cho benchmark.
    #
    # KHONG publish cong nay ra ngoai (xem docker-compose.yml). Chi container
    # trong cung Docker network moi truy cap duoc.
    #
    # Rate limit o day dat rat cao (10000r/s) de KHONG lam sai lech do
    # overhead cua Gateway khi do benchmark (theo yeu cau E).
    # ======================================================================
    server {
        listen      8081;
        server_name _;

        # Route de benchmark: chay cung mot API qua Gateway co xac thuc JWT.
        location /bench/gateway {
            limit_req zone=bench burst=1000 nodelay;

            auth_jwt_key "${JWT_SECRET}";
            auth_jwt_alg HS256;
            auth_jwt on;
            auth_jwt_require $jwt_has_sub;

            set $upstream_gateway_core "http://${GATEWAY_CORE_HOST}:${GATEWAY_CORE_PORT}";
            proxy_pass $upstream_gateway_core;

            proxy_set_header Host              $host;
            proxy_set_header Authorization     $http_authorization;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-User-Id         "";
        }

        location = /health {
            access_log off;
            return 200 '{"service":"api-gateway-bench","status":"ok"}';
        }
    }
}
